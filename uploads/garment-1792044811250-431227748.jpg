/* ==========================================================================
   ATELIER NOIR - Bespoke Contemporary Apparel Design System
   Extends & elevates Bootstrap 5 with luxury editorial aesthetics
   ========================================================================== */

@import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Playfair+Display:ital,wght@0,600;0,700;1,400&display=swap');

:root {
  --font-sans: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  --font-serif: 'Playfair Display', Georgia, serif;
  
  /* Brand Palette */
  --color-obsidian: #111215;
  --color-charcoal: #23262d;
  --color-graphite: #4b525d;
  --color-ash: #8c939f;
  --color-silver: #e4e7ec;
  --color-stone: #f7f6f2;
  --color-cream: #faf9f6;
  --color-pure-white: #ffffff;
  
  /* Accent Hues */
  --color-gold: #c29b47;
  --color-gold-hover: #aa8537;
  --color-forest: #225c43;
  --color-crimson: #c83232;
  
  /* UI Tokens */
  --border-light: 1px solid rgba(0, 0, 0, 0.08);
  --border-dark: 1px solid rgba(255, 255, 255, 0.12);
  --radius-sm: 4px;
  --radius-md: 8px;
  --radius-lg: 16px;
  --radius-full: 9999px;
  
  --shadow-subtle: 0 4px 20px rgba(0, 0, 0, 0.04);
  --shadow-elevated: 0 12px 32px rgba(0, 0, 0, 0.08);
  --shadow-floating: 0 20px 48px rgba(0, 0, 0, 0.14);
  
  --transition-fast: 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  --transition-smooth: 0.35s cubic-bezier(0.16, 1, 0.3, 1);
}

/* Base Setup */
body {
  font-family: var(--font-sans);
  color: var(--color-charcoal);
  background-color: var(--color-cream);
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  line-height: 1.6;
  overflow-x: hidden;
}

h1, h2, h3, h4, h5, h6, .font-heading {
  font-family: var(--font-sans);
  font-weight: 700;
  color: var(--color-obsidian);
  letter-spacing: -0.02em;
}

.font-serif {
  font-family: var(--font-serif);
}

a {
  color: var(--color-obsidian);
  text-decoration: none;
  transition: color var(--transition-fast);
}

a:hover {
  color: var(--color-gold);
}

/* Announcement Top Bar */
.announcement-bar {
  background-color: var(--color-obsidian);
  color: var(--color-stone);
  font-size: 0.8125rem;
  letter-spacing: 0.05em;
  padding: 0.5rem 0;
  text-transform: uppercase;
  font-weight: 500;
}

/* Header & Navbar */
.main-navbar {
  background-color: rgba(250, 249, 246, 0.95);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border-bottom: var(--border-light);
  padding: 1rem 0;
  transition: all var(--transition-smooth);
}

.navbar-brand {
  font-size: 1.5rem;
  font-weight: 800;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--color-obsidian) !important;
}

.navbar-brand span {
  color: var(--color-gold);
}

.nav-link {
  font-weight: 500;
  font-size: 0.9375rem;
  color: var(--color-charcoal) !important;
  letter-spacing: 0.02em;
  padding: 0.5rem 1rem !important;
  position: relative;
}

.nav-link::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 1rem;
  right: 1rem;
  height: 2px;
  background-color: var(--color-obsidian);
  transform: scaleX(0);
  transition: transform var(--transition-fast);
}

.nav-link:hover::after,
.nav-link.active::after {
  transform: scaleX(1);
}

.nav-icon-btn {
  background: transparent;
  border: none;
  color: var(--color-obsidian);
  font-size: 1.25rem;
  padding: 0.4rem 0.6rem;
  position: relative;
  transition: transform var(--transition-fast);
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.nav-icon-btn:hover {
  transform: translateY(-2px);
  color: var(--color-gold);
}

.nav-badge {
  position: absolute;
  top: 0;
  right: 0;
  background-color: var(--color-obsidian);
  color: var(--color-pure-white);
  font-size: 0.65rem;
  font-weight: 700;
  width: 18px;
  height: 18px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* Hero Section */
.hero-editorial {
  min-height: 85vh;
  position: relative;
  display: flex;
  align-items: center;
  background-size: cover;
  background-position: center 25%;
  background-repeat: no-repeat;
  color: var(--color-pure-white);
}

.hero-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(180deg, rgba(17, 18, 21, 0.2) 0%, rgba(17, 18, 21, 0.75) 100%);
}

.hero-content {
  position: relative;
  z-index: 2;
}

.hero-tagline {
  font-size: 0.875rem;
  letter-spacing: 0.25em;
  text-transform: uppercase;
  color: var(--color-gold);
  font-weight: 600;
  margin-bottom: 1rem;
}

.hero-title {
  font-size: clamp(2.5rem, 6vw, 4.75rem);
  font-weight: 800;
  line-height: 1.05;
  margin-bottom: 1.5rem;
  color: #ffffff;
}

/* Custom Buttons */
.btn-atelier-dark {
  background-color: var(--color-obsidian);
  color: var(--color-pure-white);
  border: 1px solid var(--color-obsidian);
  padding: 0.85rem 2rem;
  font-weight: 600;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  font-size: 0.875rem;
  border-radius: var(--radius-sm);
  transition: all var(--transition-fast);
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
}

.btn-atelier-dark:hover {
  background-color: var(--color-gold);
  border-color: var(--color-gold);
  color: var(--color-obsidian);
  transform: translateY(-2px);
  box-shadow: var(--shadow-elevated);
}

.btn-atelier-outline {
  background-color: transparent;
  color: var(--color-obsidian);
  border: 1.5px solid var(--color-obsidian);
  padding: 0.85rem 2rem;
  font-weight: 600;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  font-size: 0.875rem;
  border-radius: var(--radius-sm);
  transition: all var(--transition-fast);
}

.btn-atelier-outline:hover {
  background-color: var(--color-obsidian);
  color: var(--color-pure-white);
  transform: translateY(-2px);
}

.btn-atelier-gold {
  background-color: var(--color-gold);
  color: var(--color-obsidian);
  border: none;
  padding: 0.85rem 2rem;
  font-weight: 700;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  font-size: 0.875rem;
  border-radius: var(--radius-sm);
  transition: all var(--transition-fast);
}

.btn-atelier-gold:hover {
  background-color: var(--color-gold-hover);
  color: var(--color-obsidian);
  transform: translateY(-2px);
  box-shadow: var(--shadow-elevated);
}

/* Product Card */
.product-card {
  background: var(--color-pure-white);
  border: var(--border-light);
  border-radius: var(--radius-md);
  overflow: hidden;
  transition: all var(--transition-smooth);
  position: relative;
  display: flex;
  flex-direction: column;
  height: 100%;
}

.product-card:hover {
  transform: translateY(-6px);
  box-shadow: var(--shadow-elevated);
  border-color: rgba(0, 0, 0, 0.15);
}

.product-card-media {
  position: relative;
  padding-top: 130%; /* Fashion aspect ratio 3:4 */
  background-color: #f0eee9;
  overflow: hidden;
}

.product-card-img {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.4s ease;
}

.product-card:hover .product-card-img.primary-img {
  opacity: 0;
}

.product-card .product-card-img.hover-img {
  opacity: 0;
}

.product-card:hover .product-card-img.hover-img {
  opacity: 1;
  transform: scale(1.05);
}

.product-badge-stack {
  position: absolute;
  top: 12px;
  left: 12px;
  z-index: 3;
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.badge-atelier {
  font-size: 0.6875rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  padding: 4px 10px;
  border-radius: var(--radius-sm);
}

.badge-new {
  background-color: var(--color-obsidian);
  color: #fff;
}

.badge-sale {
  background-color: var(--color-crimson);
  color: #fff;
}

.badge-low-stock {
  background-color: var(--color-gold);
  color: var(--color-obsidian);
}

.badge-eco {
  background-color: var(--color-forest);
  color: #fff;
}

.product-quick-wishlist {
  position: absolute;
  top: 12px;
  right: 12px;
  z-index: 3;
  width: 36px;
  height: 36px;
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(4px);
  border-radius: 50%;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-obsidian);
  transition: all var(--transition-fast);
}

.product-quick-wishlist:hover,
.product-quick-wishlist.active {
  background: var(--color-obsidian);
  color: #fff;
  transform: scale(1.1);
}

.product-card-body {
  padding: 1.25rem;
  display: flex;
  flex-direction: column;
  flex-grow: 1;
}

.product-category-sub {
  font-size: 0.75rem;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: var(--color-ash);
  font-weight: 600;
  margin-bottom: 0.25rem;
}

.product-card-title {
  font-size: 1rem;
  font-weight: 600;
  margin-bottom: 0.5rem;
  line-height: 1.35;
}

.product-price-row {
  display: flex;
  align-items: baseline;
  gap: 8px;
  margin-top: auto;
  padding-top: 0.75rem;
}

.product-current-price {
  font-size: 1.125rem;
  font-weight: 700;
  color: var(--color-obsidian);
}

.product-old-price {
  font-size: 0.875rem;
  color: var(--color-ash);
  text-decoration: line-through;
}

.product-color-swatches {
  display: flex;
  align-items: center;
  gap: 6px;
  margin-top: 0.75rem;
}

.swatch-pill {
  width: 14px;
  height: 14px;
  border-radius: 50%;
  border: 1px solid rgba(0, 0, 0, 0.2);
  display: inline-block;
  cursor: pointer;
  transition: transform var(--transition-fast);
}

.swatch-pill:hover,
.swatch-pill.active {
  transform: scale(1.3);
  box-shadow: 0 0 0 2px var(--color-obsidian);
}

/* Category Grid Tiles */
.category-tile {
  position: relative;
  height: 420px;
  border-radius: var(--radius-md);
  overflow: hidden;
  display: flex;
  align-items: flex-end;
  padding: 2rem;
  color: #fff;
}

.category-tile-bg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  z-index: 1;
}

.category-tile:hover .category-tile-bg {
  transform: scale(1.08);
}

.category-tile-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0.05) 0%, rgba(0, 0, 0, 0.75) 100%);
  z-index: 2;
}

.category-tile-content {
  position: relative;
  z-index: 3;
}

/* Faceted Filter Sidebar */
.filter-card {
  background: var(--color-pure-white);
  border: var(--border-light);
  border-radius: var(--radius-md);
  padding: 1.5rem;
}

.filter-title {
  font-size: 0.875rem;
  font-weight: 700;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  margin-bottom: 1rem;
}

.filter-size-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 8px;
}

.size-btn {
  border: 1px solid var(--color-silver);
  background: var(--color-pure-white);
  padding: 8px 4px;
  font-size: 0.8125rem;
  font-weight: 600;
  border-radius: var(--radius-sm);
  text-align: center;
  cursor: pointer;
  transition: all var(--transition-fast);
}

.size-btn:hover,
.size-btn.active {
  background: var(--color-obsidian);
  color: #fff;
  border-color: var(--color-obsidian);
}

.size-btn.disabled {
  opacity: 0.35;
  cursor: not-allowed;
  text-decoration: line-through;
  background: #f5f5f5;
}

/* Offcanvas Cart Drawer */
.cart-offcanvas {
  width: 440px !important;
  max-width: 90vw;
  background: var(--color-cream);
  border-left: var(--border-light);
}

.cart-item-row {
  display: flex;
  gap: 14px;
  padding: 1rem 0;
  border-bottom: var(--border-light);
}

.cart-item-thumb {
  width: 80px;
  height: 100px;
  object-fit: cover;
  border-radius: var(--radius-sm);
  background: #eae8e3;
  flex-shrink: 0;
}

.cart-qty-control {
  display: inline-flex;
  align-items: center;
  border: 1px solid var(--color-silver);
  border-radius: var(--radius-sm);
  background: #fff;
}

.cart-qty-btn {
  border: none;
  background: transparent;
  padding: 2px 10px;
  font-weight: 700;
  color: var(--color-obsidian);
}

.cart-qty-value {
  padding: 0 8px;
  font-size: 0.875rem;
  font-weight: 600;
}

.free-shipping-progress {
  background-color: #ebe9e4;
  height: 6px;
  border-radius: var(--radius-full);
  overflow: hidden;
  margin: 8px 0;
}

.free-shipping-bar {
  background-color: var(--color-forest);
  height: 100%;
  transition: width 0.4s ease;
}

/* Product Detail Page (PDP) Specifics */
.pdp-gallery-main {
  position: sticky;
  top: 100px;
}

.pdp-main-image {
  width: 100%;
  height: 640px;
  object-fit: cover;
  border-radius: var(--radius-md);
  background-color: #ebe9e4;
  cursor: zoom-in;
}

.pdp-thumb-list {
  display: flex;
  gap: 12px;
  margin-top: 12px;
  overflow-x: auto;
  padding-bottom: 4px;
}

.pdp-thumb-item {
  width: 88px;
  height: 110px;
  object-fit: cover;
  border-radius: var(--radius-sm);
  cursor: pointer;
  border: 2px solid transparent;
  opacity: 0.7;
  transition: all var(--transition-fast);
  flex-shrink: 0;
}

.pdp-thumb-item:hover,
.pdp-thumb-item.active {
  opacity: 1;
  border-color: var(--color-obsidian);
}

.pdp-stock-alert {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-size: 0.8125rem;
  font-weight: 600;
  padding: 6px 12px;
  border-radius: var(--radius-sm);
}

.pdp-stock-alert.urgent {
  background-color: #fde8e8;
  color: var(--color-crimson);
}

.pdp-stock-alert.available {
  background-color: #e6f4ea;
  color: var(--color-forest);
}

/* Toast Alerts */
.atelier-toast-container {
  position: fixed;
  bottom: 24px;
  right: 24px;
  z-index: 1090;
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.atelier-toast {
  background: var(--color-obsidian);
  color: #fff;
  padding: 14px 20px;
  border-radius: var(--radius-sm);
  box-shadow: var(--shadow-floating);
  display: flex;
  align-items: center;
  gap: 12px;
  font-size: 0.875rem;
  font-weight: 500;
  animation: slideInUp 0.3s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  max-width: 380px;
}

@keyframes slideInUp {
  from {
    opacity: 0;
    transform: translateY(20px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* Timeline on Order Tracking */
.order-tracking-steps {
  display: flex;
  justify-content: space-between;
  position: relative;
  margin: 3rem 0;
}

.order-tracking-steps::before {
  content: '';
  position: absolute;
  top: 24px;
  left: 20px;
  right: 20px;
  height: 3px;
  background-color: var(--color-silver);
  z-index: 1;
}

.tracking-step {
  position: relative;
  z-index: 2;
  text-align: center;
  width: 90px;
}

.tracking-step-icon {
  width: 48px;
  height: 48px;
  border-radius: 50%;
  background: #fff;
  border: 3px solid var(--color-silver);
  color: var(--color-ash);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 10px auto;
  font-size: 1.25rem;
  transition: all var(--transition-fast);
}

.tracking-step.completed .tracking-step-icon {
  background: var(--color-forest);
  border-color: var(--color-forest);
  color: #fff;
}

.tracking-step.active .tracking-step-icon {
  background: var(--color-gold);
  border-color: var(--color-gold);
  color: var(--color-obsidian);
  box-shadow: 0 0 0 6px rgba(194, 155, 71, 0.2);
}

.tracking-step-label {
  font-size: 0.75rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: var(--color-graphite);
}

/* Footer */
.main-footer {
  background-color: var(--color-obsidian);
  color: var(--color-silver);
  padding-top: 5rem;
  padding-bottom: 3rem;
  margin-top: 6rem;
  border-top: 1px solid rgba(255, 255, 255, 0.08);
}

.footer-heading {
  color: #fff;
  font-size: 0.875rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  margin-bottom: 1.5rem;
  font-weight: 700;
}

.footer-links {
  list-style: none;
  padding: 0;
  margin: 0;
}

.footer-links li {
  margin-bottom: 0.75rem;
}

.footer-links a {
  color: #9aa1ad;
  font-size: 0.875rem;
  transition: color var(--transition-fast);
}

.footer-links a:hover {
  color: var(--color-gold);
}

/* Responsive tweaks */
@media (max-width: 991.98px) {
  .pdp-main-image {
    height: 480px;
  }
  .hero-editorial {
    min-height: 70vh;
  }
}
